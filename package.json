{
  "name": "paseo-office-viewer",
  "version": "1.1.1",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/fowill/paseo-office-viewer.git" },
  "description": "Local, read-only Office and PDF previews for Paseo Desktop",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx server/standalone.ts",
    "fixtures": "node scripts/create-fixtures.mjs",
    "test:paseo": "node scripts/paseo-smoke.mjs",
    "test": "node --import tsx --test tests/server.test.ts",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "check": "npm run build && npm run typecheck && npm run fixtures && npm test && npm run test:browser"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "docx-preview": "0.4.1",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.624",
    "pptxviewjs": "1.1.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0-beta.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "docx": "9.12.0",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "~19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22.14.0" }
}
